# Backend base URL including /api/v1. Leave unset in development: the Vite dev server proxies /api to http://localhost:3000.
# VITE_API_URL=https://attendance.example.ac.th/api/v1

# Google Maps JavaScript API key (restricted by HTTP referrer, Maps JavaScript API only).
# Leave empty to use the built-in schematic (SVG) map.
VITE_GOOGLE_MAPS_API_KEY=
