# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://attendance:attendance@localhost:5432/attendance?schema=public
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Admin web origin(s), comma separated
CORS_ORIGINS=http://localhost:5173
# Base URL used in activation / password-reset emails (served by the admin web)
APP_LINK_BASE=http://localhost:5173
# Mailpit from docker compose (UI at http://localhost:8025). Leave SMTP_HOST empty to log emails instead.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Faculty Attendance <no-reply@siit.tu.ac.th>"
# Location evidence retention (agree with the institution before deployment)
EVIDENCE_RETENTION_DAYS=365
ENABLE_JOBS=true
# Emulator GPX / mock-location testing only. Refused when NODE_ENV=production.
ALLOW_MOCK_LOCATION=false
