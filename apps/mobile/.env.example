# Copy to .env.local (git-ignored). Expo reads it when it builds the native app.
#
# Google Maps SDK for Android key for the location map (mockup page 5). In Google Cloud Console:
#   APIs & Services → enable "Maps SDK for Android" → Credentials → API key →
#   Application restriction "Android apps": package th.ac.siit.attendance + the SHA-1 of the signing key
#   (debug: `keytool -list -v -keystore android/app/debug.keystore -alias androiddebugkey -storepass android`).
#   API restriction: Maps SDK for Android only.
# The key is compiled into AndroidManifest.xml, so after changing it run:  npx expo prebuild --platform android
# then rebuild (pnpm android). Without a key the map screen shows a text fallback.
GOOGLE_MAPS_ANDROID_KEY=

# Optional: API URL for a real phone on the same Wi-Fi (default is the emulator's http://10.0.2.2:3000/api/v1)
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api/v1
