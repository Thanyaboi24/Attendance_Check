# Server settings. install.sh copies this file to .env and fills in the secrets.
# Keep .env private: it holds the database password and the token-signing secret.

DOMAIN=siitatt.bsoftsolutions.net
# Email for Let's Encrypt certificate notices (expiry warnings). Required.
ACME_EMAIL=

# Generated by install.sh (letters and digits only). Don't change them after the first start:
# POSTGRES_PASSWORD is stored in the database volume, and a new JWT_SECRET signs everyone out.
POSTGRES_PASSWORD=
JWT_SECRET=

# Outgoing email for account activation, password reset and sign-up decisions.
# Leave SMTP_HOST empty to run without email (activation links are then printed by create-admin.sh only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Faculty Attendance <no-reply@siit.tu.ac.th>

# Staff self sign-up from the mobile app (an administrator still approves every account).
SIGNUP_ENABLED=true
SIGNUP_EMAIL_DOMAINS=siit.tu.ac.th,g.siit.tu.ac.th

# How long location evidence is kept, in days (agree this with the institution).
EVIDENCE_RETENTION_DAYS=365

# API documentation at /api/v1/docs. Keep false in production unless needed.
ENABLE_SWAGGER=false

# Public ports. Keep 80 and 443: the HTTPS certificate is issued through them.
HTTP_PORT=80
HTTPS_PORT=443
